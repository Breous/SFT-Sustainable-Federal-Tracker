@page
@model SFT.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="fw-bold mb-4" style="color: #00A86B;">Create Axiom Account</h2>
            
            <form method="post" class="shadow-sm p-4 bg-white border rounded">
                <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">First Name</label>
                        <input asp-for="Input.FirstName" class="form-control" placeholder="Enter first name" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Last Name</label>
                        <input asp-for="Input.LastName" class="form-control" placeholder="Enter last name" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="fw-bold">Email Address</label>
                    <input asp-for="Input.Email" class="form-control" placeholder="email@example.com" />
                </div>

                <div class="form-group mb-3">
                    <label class="fw-bold">Security Password</label>
                    <input asp-for="Input.Password" class="form-control" type="password" />
                </div>

                <div class="form-group mb-4">
                    <label class="fw-bold">Sustainability Level</label>
                    <input asp-for="Input.SustainabilityLevel" class="form-control" placeholder="Standard / Pro / Elite" />
                    <span asp-validation-for="Input.SustainabilityLevel" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-lg w-100 shadow-sm" 
                        style="background-color: #00A86B; color: white; border: none; font-weight: 700;">
                    INITIALIZE ACCOUNT
                </button>
                
                <div class="mt-3 text-center">
                    <p class="small text-muted">By registering, you agree to the Humanity One Transparency Standards.</p>
                </div>
            </form>
        </div>
    </div>
</div>